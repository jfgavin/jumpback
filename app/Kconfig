mainmenu "Jumpback"

config ST7306_WAVESHARE
	bool "Waveshare ST7306 landscape display driver"
	default y
	depends on DT_HAS_WAVESHARE_ST7306_LANDSCAPE_ENABLED
	select MIPI_DBI
	help
	  Landscape driver for the reflective LCD on the Waveshare
	  ESP32-S3-RLCD-4.2. Rotates the framebuffer in software.

if ST7306_WAVESHARE

config ST7306_WAVESHARE_CONV_BUFFER_STRIPS
	int "Conversion buffer size, in panel row-address strips"
	default 16
	range 1 200
	help
	  Rotated panel rows staged per SPI transaction, two rows per strip.
	  200 stages a whole 300x400 frame.

endif # ST7306_WAVESHARE

config JUMPBACK_FPS_COUNTER
	bool "Report achieved frame rate on the heartbeat"
	help
	  Add frames per second and average render time to the once-per-second
	  heartbeat log line.

source "Kconfig.zephyr"
