#include <dt-bindings/display/st7306.h>

#define RLCD_PANEL_WIDTH  300
#define RLCD_PANEL_HEIGHT 400

&st7306 {
	status = "disabled";
};

/ {
	mipi_dbi {
		st7306_landscape: st7306_landscape@0 {
			compatible = "waveshare,st7306-landscape";
			reg = <0>;
			status = "okay";

			mipi-max-frequency = <10000000>;
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";

			panel-width = <RLCD_PANEL_WIDTH>;
			panel-height = <RLCD_PANEL_HEIGHT>;
			width = <RLCD_PANEL_HEIGHT>;
			height = <RLCD_PANEL_WIDTH>;

			start-line = <0>;
			start-column = <216>;

			nvm-load = [17 02];
			gate-voltages = [11 04];
			vsh = [69 69 69 69];
			vsl = [19 19 19 19];
			vshn = [4b 4b 4b 4b];
			vsln = [19 19 19 19];
			osc-settings = <ST7306_OSC_ENABLE>;
			framerate = <(ST7306_FRAMERATE_HPM_51HZ | ST7306_FRAMERATE_LPM_1HZ)>;
			multiplex-ratio = <(RLCD_PANEL_HEIGHT / ST7306_GATE_LINES_PER_MULTIPLEX_STEP)>;
			source-voltage = <0>;
			remap-value = <(ST7306_MADCTL_MX | ST7306_MADCTL_DO)>;
			panel-settings = <0x29>;
			hpm-gate-waveform = [e5 f6 05 46 77 77 77 77 76 45];
			lpm-gate-waveform = [05 46 77 77 77 77 76 45];
		};
	};

	chosen {
		zephyr,display = &st7306_landscape;
	};
};
