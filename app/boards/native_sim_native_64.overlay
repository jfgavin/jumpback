#include <zephyr/dt-bindings/display/panel.h>

&sdl_dc {
	width = <400>;
	height = <300>;
	pixel-format = <PANEL_PIXEL_FORMAT_MONO01>;
};

/ {
	gnss: gnss-emul {
		compatible = "zephyr,gnss-emul";
		status = "okay";
	};

	aliases {
		gnss = &gnss;
	};
};
